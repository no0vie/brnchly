{
  "name": "brnchly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:core && vite",
    "build": "npm run build:packages && tsc && vite build",
    "build:pages": "VITE_BASE_PATH=/brnchly/ npm run build && cp dist/index.html dist/404.html",
    "build:core": "npm run build --workspace @no0vie/brnchly-core",
    "build:react": "npm run build --workspace @no0vie/brnchly-react",
    "build:packages": "npm run build:core && npm run build:react",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write '**/*.{ts,tsx,css,json,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,css,json,md}'",
    "test": "npm run build:packages && vitest run",
    "test:consumer": "node scripts/test-package-distribution.mjs",
    "pack:dry-run": "node scripts/test-package-distribution.mjs --dry-run",
    "test:e2e": "playwright test",
    "test:ci:e2e": "playwright test e2e/phase4-editor.spec.ts e2e/evolution.spec.ts --project=chromium && playwright test e2e/reduced-motion.spec.ts --project=chromium-reduced-motion",
    "test:smoke": "playwright test e2e/evolution.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "profile:chromium": "playwright test e2e/performance.spec.ts --project=chromium --workers=1",
    "profile:production": "npm run build && playwright test e2e/performance.spec.ts --config=playwright.production.config.ts --project=chromium --workers=1",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no0vie/brnchly.git"
  },
  "license": "MIT",
  "dependencies": {
    "@no0vie/brnchly-core": "1.0.0",
    "@no0vie/brnchly-react": "1.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "antd": "^5.12.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.2.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
